---
import StoreBadges from './StoreBadges.astro';
import Waitlist from './Waitlist.astro';
import { marketingLabels, marketingLinks } from '../marketing/content';
import { getDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const links = marketingLinks(locale);
const labels = marketingLabels(locale);
const c = getDict(locale).cta;
---

<section class="cta" id="waitlist">
  <div class="container">
    <div class="cta__panel">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="cta__title">
        {c.titleLead}<br />
        <span class="accent">{c.titleAccent}</span>
      </h2>
      <p class="lede cta__lede">{c.lede}</p>
      <div class="cta__act">
        <>{links.webAppUrl ? <a class="btn" href={links.webAppUrl} data-marketing-event="web_app_cta">{labels.open} →</a> : <Waitlist locale={locale} compact />}</>
        <StoreBadges locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-bottom: clamp(5rem, 10vw, 9rem);
  }
  .cta__act {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    margin-top: 0.4rem;
  }
  .cta__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.4rem;
    padding: clamp(3rem, 7vw, 6rem) clamp(1.5rem, 5vw, 5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--ink-1);
    border-top: 2px solid var(--amber);
    overflow: hidden;
  }
  .cta__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 3rem,
      linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 3rem 100%;
    mask-image: radial-gradient(80% 80% at 50% 50%, #000, transparent 75%);
    opacity: 0.35;
  }
  .cta__panel > * {
    position: relative;
  }
  .cta__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2rem, 1.2rem + 3.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.018em;
  }
  .cta__title .accent {
    color: var(--amber);
    font-style: italic;
  }
  .cta__lede {
    max-width: 44ch;
  }
</style>
