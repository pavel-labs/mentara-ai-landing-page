---
import StoreBadges from './StoreBadges.astro';
import { getDict, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = getDict(locale).cta;
---

<section class="cta" id="waitlist">
  <div class="container">
    <div class="cta__panel">
      <p class="eyebrow">{c.eyebrow}</p>
      <h2 class="cta__title">
        {c.titleLead}
        <br />
        <span class="accent">{c.titleAccent}</span>
      </h2>
      <p class="lede cta__lede">{c.lede}</p>
      <div class="cta__act">
        <StoreBadges locale={locale} />
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 0 var(--section-space);
  }
  .cta__panel {
    display: grid;
    justify-items: center;
    gap: 1.5rem;
    padding: clamp(3rem, 8vw, 7rem) clamp(1.5rem, 5vw, 5rem);
    border-radius: var(--radius-lg);
    background: var(--accent);
    text-align: center;
  }
  .cta__title {
    max-width: 21ch;
    font-size: clamp(2.5rem, 5.5vw, 5.5rem);
    letter-spacing: -0.055em;
  }
  .cta__title .accent {
    color: var(--accent-ink);
  }
  .cta__lede {
    max-width: 45ch;
  }
  .cta__act {
    display: grid;
    justify-items: center;
    gap: 1rem;
    margin-top: 0.75rem;
  }
  .cta__act :global(.badge) {
    background: #f5f9e480;
    border-color: #9cb65f;
  }
</style>
