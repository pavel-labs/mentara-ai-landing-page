---
import { marketingLanding, marketingLinks, marketingLabels } from '../marketing/content';
import StoreBadges from './StoreBadges.astro';
import { SITE } from '../consts';
import { getDict, localeHome, localePath, resolveNavHref, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const content = marketingLanding(locale);
const links = marketingLinks(locale);
const labels = marketingLabels(locale);
const year = new Date().getFullYear();
// Footer is shared by the landing AND the legal pages, so section links must point at the
// localized home + anchor (not a bare #anchor that 404s the scroll off-page).
const home = localeHome(locale);

---

<footer class="foot">
  <div class="container foot__grid">
    <div class="foot__brand">
      <a href={home} class="foot__word">{SITE.name}</a>
      <p class="mono">{content?.footerDescription ?? t.footer.blurb}</p>
      <StoreBadges locale={locale} />
    </div>

    <nav class="foot__nav" aria-label="Footer">
      <span class="foot__label">{t.footer.explore}</span>
      {content ? <><a href={`${home}#product`}>{labels.products}</a><a href={`${home}#pricing`}>{content.pricing.heading}</a></> : t.nav.map((l) => <a href={resolveNavHref(locale, home, l.href)}>{l.label}</a>)}
      <a href={localePath(locale, 'articles')}>{labels.articles}</a>
      {links.social.map((link) => <a href={link.url} rel="noopener noreferrer">{link.label}</a>)}
    </nav>

    <nav class="foot__nav" aria-label="Legal">
      <span class="foot__label">{t.footer.legal}</span>
      <a href={localePath(locale, 'privacy')}>{t.footer.privacy}</a>
      <a href={localePath(locale, 'terms')}>{t.footer.terms}</a>
    </nav>
  </div>

  <div class="container foot__base">
    <span class="mono">© {year} {SITE.name}</span>
    <span class="mono">{links.webAppUrl ? labels.available : t.meta.launchLabel}</span>
  </div>
</footer>

<style>
  .foot {
    border-top: 1px solid var(--line);
    background: rgba(0, 0, 0, 0.3);
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
  }
  .foot__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 2.5rem;
    padding-bottom: 3rem;
  }
  .foot__word {
    font-family: var(--font-display);
    font-weight: 620;
    font-size: 1.6rem;
    letter-spacing: -0.02em;
  }
  .foot__brand :global(.badges) { margin-top: 1.4rem; }
  .foot__brand .mono {
    margin-top: 0.7rem;
  }
  .foot__nav {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    font-size: 0.95rem;
    color: var(--bone-dim);
  }
  .foot__nav a {
    transition: color 0.2s;
  }
  .foot__nav a:hover {
    color: var(--amber);
  }
  .foot__label {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--bone-faint);
    margin-bottom: 0.3rem;
  }
  .foot__muted {
    color: var(--bone-faint);
    font-size: 0.9rem;
  }
  .foot__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 720px) {
    .foot__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
