---
import { marketingLanding, marketingLinks, marketingLabels } from '../marketing/content';
import StoreBadges from './StoreBadges.astro';
import { SITE } from '../consts';
import { getDict, localeHome, localePath, resolveNavHref, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);
const content = marketingLanding(locale);
const links = marketingLinks(locale);
const labels = marketingLabels(locale);
const year = new Date().getFullYear();
// Footer is shared by the landing AND the legal pages, so section links must point at the
// localized home + anchor (not a bare #anchor that 404s the scroll off-page).
const home = localeHome(locale);
---

<footer class="foot theme-dark">
  <div class="container foot__grid">
    <div class="foot__brand">
      <a href={home} class="foot__word">
        {SITE.name}
      </a>
      <p class="mono">{content?.footerDescription ?? t.footer.blurb}</p>
      <StoreBadges locale={locale} />
    </div>

    <nav class="foot__nav" aria-label="Footer">
      <span class="foot__label">{t.footer.explore}</span>
      {content ? (
        <>
          <a href={`${home}#product`}>{labels.products}</a>
          <a href={`${home}#pricing`}>{content.pricing.heading}</a>
        </>
      ) : (
        t.nav.map((l) => <a href={resolveNavHref(locale, home, l.href)}>{l.label}</a>)
      )}
      <a href={localePath(locale, 'articles')}>{labels.articles}</a>
      {links.social.map((link) => (
        <a href={link.url} rel="noopener noreferrer">
          {link.label}
        </a>
      ))}
    </nav>

    <nav class="foot__nav" aria-label="Legal">
      <span class="foot__label">{t.footer.legal}</span>
      <a href={localePath(locale, 'privacy')}>{t.footer.privacy}</a>
      <a href={localePath(locale, 'terms')}>{t.footer.terms}</a>
    </nav>
  </div>

  <div class="container foot__base">
    <span class="mono">
      © {year} {SITE.name}
    </span>
    <span class="mono">{t.meta.launchLabel}</span>
  </div>
</footer>

<style>
  .foot {
    padding-block: clamp(3rem, 6vw, 5rem) 2rem;
    background: #14251a;
  }
  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr) minmax(0, 0.7fr);
    gap: 3rem;
    padding-bottom: 3rem;
  }
  .foot__word {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 1;
  }
  .foot__brand .mono {
    max-width: 36ch;
    margin-top: 1.25rem;
  }
  .foot__brand :global(.badges) {
    margin-top: 1.5rem;
  }
  .foot__nav {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.75rem;
    min-width: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .foot__nav a:hover {
    color: var(--accent-ink);
  }
  .foot__label {
    margin-bottom: 0.6rem;
    color: var(--text);
    font-weight: 600;
  }
  .foot__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 800px) {
    .foot__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2.5rem 1.5rem;
    }
    .foot__brand {
      grid-column: 1 / -1;
    }
    .foot__brand :global(.badges) {
      max-width: 30rem;
    }
  }
</style>
