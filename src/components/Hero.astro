---
import StoreBadges from './StoreBadges.astro';
import Waitlist from './Waitlist.astro';
import { marketingLabels, marketingLinks } from '../marketing/content';
import { getDict, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const links = marketingLinks(locale);
const labels = marketingLabels(locale);
const t = getDict(locale);
const m = t.interview.mock;
// The illustration shows the interview in its deep-dive phase: the moment a follow-up
// lands on the candidate's own answer, which is the product's core difference.
const activePhase = 2;
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow" data-reveal style="--d:0">{t.hero.eyebrow}</p>

      <h1 class="display" data-reveal style="--d:1">
        {t.hero.titleLead}
        <span class="accent">{t.hero.titleAccent}</span>
      </h1>

      <p class="lede" data-reveal style="--d:2">{t.hero.lede}</p>

      <div class="hero__cta" data-reveal style="--d:3">
        <>{links.webAppUrl ? <a class="btn" href={links.webAppUrl} data-marketing-event="web_app_cta">{labels.open} →</a> : <Waitlist locale={locale} />}</>
        <a class="link-arrow" href={localePath(locale, 'enterprise')} data-marketing-event="enterprise_cta">{t.hero.teamsLink} →</a>
        <StoreBadges locale={locale} />
        <p class="mono hero__launch">
          <span class="dot" aria-hidden="true"></span>
          {links.webAppUrl ? labels.available : t.hero.availability}
        </p>
      </div>
    </div>

    <figure class="mock hero__mock" data-reveal style="--d:3" aria-label={m.label}>
      <div class="mock__bar">
        <span>{m.label}</span>
      </div>
      <ol class="phases" aria-label={m.phases.join(' → ')}>
        {
          m.phases.map((p, i) => (
            <li
              class:list={['phase', { 'phase--done': i < activePhase, 'phase--on': i === activePhase }]}
              aria-current={i === activePhase ? 'step' : undefined}
            >
              {p}
            </li>
          ))
        }
      </ol>
      <div class="mock__body">
        <div class="line">
          <span class="who">{m.interviewer}</span>
          <p class="bubble">{m.q}</p>
        </div>
        <div class="line">
          <span class="who">{m.you}</span>
          <p class="bubble bubble--you">{m.a}</p>
        </div>
        <div class="line line--follow">
          <span class="who">{m.interviewer}</span>
          <p class="bubble">{m.followUp}</p>
        </div>
        <div class="hero__foot">
          <span class="hints" aria-label={m.hints}>
            <i></i><i></i><i class="spent"></i>
            <span class="mono">{m.hints}</span>
          </span>
          <span class="mic mono">
            <span class="mic__dot" aria-hidden="true"></span>
            {m.voice}
          </span>
        </div>
      </div>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 7vw, 6rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .hero__grid {
    display: grid;
    /* minmax(0,…): without it, fr tracks keep min-width:auto and the longer copy in
       some locales (e.g. Russian) inflates the left track, starving the panel. */
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    min-width: 0;
  }
  .hero .display {
    /* The positioning line is longer than the old headline; a smaller ceiling keeps the
       waitlist above the fold on a laptop screen. */
    font-size: clamp(2.3rem, 1.3rem + 3.6vw, 3.9rem);
  }
  .display .accent {
    display: block;
    color: var(--amber);
    font-style: italic;
  }
  .hero__cta {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin-top: 0.6rem;
  }
  .hero__launch {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .phases {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-bottom: 1px solid var(--line);
  }
  .phase {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--bone-faint);
    padding: 0.6rem 0.5rem;
    text-align: center;
    border-bottom: 2px solid transparent;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .phase--done {
    color: var(--bone-dim);
    border-bottom-color: var(--line-strong);
  }
  .phase--on {
    color: var(--bone);
    border-bottom-color: var(--amber);
  }
  .line {
    display: grid;
    gap: 0.35rem;
  }
  .line--follow .bubble {
    border-left: 2px solid var(--amber);
  }
  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.8rem;
    padding-top: 1rem;
    border-top: 1px dashed var(--line-strong);
  }
  .hints {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .hints i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--amber);
  }
  .hints i.spent {
    background: var(--ink-3);
  }
  .hints .mono {
    margin-left: 0.3rem;
  }
  .mic {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--bone-dim);
  }
  .mic__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--sage);
  }

  /* Four phase names in one row do not fit a phone in the longer languages
     ("Podsumowanie", "Calentamiento") in spaced uppercase; drop the tracking there so
     they fit whole instead of being cut off with an ellipsis. */
  @media (prefers-reduced-motion: no-preference) and (min-width: 921px) {
    .hero__mock { transform: perspective(1200px) rotateY(-8deg) rotateX(3deg); box-shadow: 24px 28px 70px #0006; }
  }
  @media (max-width: 520px) {
    .phase {
      padding-inline: 0.15rem;
      font-size: 0.6rem;
      letter-spacing: 0;
      text-transform: none;
      text-overflow: clip;
    }
  }
  @media (max-width: 920px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
