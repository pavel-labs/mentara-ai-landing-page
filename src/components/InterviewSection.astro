---
import { getDict, type Locale } from '../i18n';
import FlowSteps from './FlowSteps.astro';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const iv = getDict(locale).interview;
---

<section id="interview" class="interview theme-dark">
  <div class="container">
    <SectionHead eyebrow={iv.eyebrow} heading={iv.heading} />
    <p class="lede iv__lede">{iv.lede}</p>
    <FlowSteps steps={iv.steps} />
    <p class="note iv__note">{iv.honesty}</p>
  </div>
</section>

<style>
  .interview {
    background: #193629;
  }
  .iv__lede {
    max-width: 66ch;
    margin-top: -1rem;
    margin-bottom: 3.5rem;
  }
  .iv__note {
    margin-top: 3rem;
  }
</style>
