---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Locale } from '../i18n';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import Proof from './Proof.astro';
import WhyPractice from './WhyPractice.astro';
import InterviewSection from './InterviewSection.astro';
import AssessmentSection from './AssessmentSection.astro';
import ReportSection from './ReportSection.astro';
import ProgressSection from './ProgressSection.astro';
import Pricing from './Pricing.astro';
import TeamsBand from './TeamsBand.astro';
import FAQ from './FAQ.astro';
import CTA from './CTA.astro';
import BlogTeaser from './BlogTeaser.astro';
import Footer from './Footer.astro';
import ManagedLanding from './ManagedLanding.astro';
import Articles from './Articles.astro';
import { marketingLanding, publishedArticles } from '../marketing/content';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const content = marketingLanding(locale);
const enabledFaq = content?.faq.filter((item) => item.enabled);
---

<BaseLayout
  locale={locale}
  autoLocale
  includeFaq={content ? (enabledFaq?.length ?? 0) > 0 : true}
  title={content?.seo.title}
  description={content?.seo.description}
  ogImageUrl={content?.seo.image?.url}
  faqItems={enabledFaq?.map((item) => ({ q: item.question, a: item.answer }))}
>
  <Nav locale={locale} />
  <main id="main">
    {content ? <ManagedLanding content={content} /> : <>
    <Hero locale={locale} />
    <Proof locale={locale} />
    <WhyPractice locale={locale} />
    <InterviewSection locale={locale} />
    <AssessmentSection locale={locale} />
    <ReportSection locale={locale} />
    <ProgressSection locale={locale} />
    <Pricing locale={locale} />
    <TeamsBand locale={locale} />
    <FAQ locale={locale} />
    <CTA locale={locale} />
    </>}
    {publishedArticles(locale).length > 0 && <Articles locale={locale} compact />}
    <BlogTeaser locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
