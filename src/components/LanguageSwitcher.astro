---
import { LOCALES, LOCALE_STORAGE_KEY, getDict, localeHome, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<nav class="lang" aria-label="Language" data-lang-store={LOCALE_STORAGE_KEY}>
  {
    LOCALES.map((l) => {
      const current = l === locale;
      return (
        <a
          href={localeHome(l)}
          class:list={['lang__opt', { 'lang__opt--on': current }]}
          hreflang={l}
          lang={l}
          aria-current={current ? 'page' : undefined}
          title={getDict(l).langName}
        >
          {l.toUpperCase()}
        </a>
      );
    })
  }
</nav>

{/*
  Clicking a language is an explicit choice: remember it so the browser-language
  auto-redirect on the home page stops second-guessing the visitor.
*/}
<script>
  document.querySelectorAll<HTMLElement>('.lang[data-lang-store]').forEach((nav) => {
    const key = nav.dataset.langStore;
    if (key == null) return;
    nav.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest<HTMLAnchorElement>('a[hreflang]');
      if (link == null) return;
      try {
        localStorage.setItem(key, link.hreflang);
      } catch {
        // Private mode / storage disabled – the click still navigates.
      }
    });
  });
</script>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 2px;
    padding: 0.2rem;
  }
  .lang__opt {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--bone-faint);
    padding: 0.3rem 0.55rem;
    border-radius: 2px;
    transition:
      color 0.2s,
      background 0.2s;
  }
  .lang__opt:hover {
    color: var(--bone);
  }
  .lang__opt--on {
    color: var(--ink);
    background: var(--amber);
  }
  .lang__opt--on:hover {
    color: var(--ink);
  }
</style>
