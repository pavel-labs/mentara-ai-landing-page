---
import { DEFAULT_LOCALE, LOCALES, LOCALE_STORAGE_KEY, localeHome, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

// Build-time map locale → home URL, so the client never has to redo base-path math.
const homes = Object.fromEntries(LOCALES.map((l) => [l, localeHome(l)]));
---

{/*
  Sends a first-time visitor to the home page in their browser's language. Rendered on
  locale home pages only (BaseLayout's `autoLocale` prop) – deep links keep the language
  they were shared in, which matters because the blog is English-only by design.

  Browser language is consulted only on the default-locale home (`/`, the x-default).
  An explicit /de/, /ru/, … URL is a choice already made – by the person who shared the
  link or by a search result – so it is never overridden by browser language. That also
  keeps crawlers (which render with an English locale) from being bounced off the
  localized homes, which would keep them out of the index. A stored switcher pick still
  wins everywhere.

  Inline and in <head> on purpose: it must decide before first paint, otherwise a
  redirected visitor sees the wrong language flash first.
*/}
<script
  is:inline
  define:vars={{
    current: locale,
    isDefault: locale === DEFAULT_LOCALE,
    homes,
    storageKey: LOCALE_STORAGE_KEY,
  }}
>
  (function autoLocale() {
    // An explicit pick in the language switcher always wins over browser languages.
    function storedChoice() {
      try {
        const saved = localStorage.getItem(storageKey);
        return saved && homes[saved] ? saved : null;
      } catch {
        // Private mode or storage disabled – fall through to browser languages.
        return null;
      }
    }

    // "ru-RU" → "ru". Ordered by the visitor's own preference list.
    function browserChoice() {
      const tags = navigator.languages?.length ? navigator.languages : [navigator.language];
      for (const tag of tags) {
        const language = String(tag ?? '')
          .toLowerCase()
          .split('-')[0];
        if (homes[language]) return language;
      }
      return null;
    }

    const target = storedChoice() ?? (isDefault ? browserChoice() : null);

    // `replace`, not `assign`: Back should leave the site, not bounce through the redirect.
    if (target && target !== current) location.replace(homes[target]);
  })();
</script>
