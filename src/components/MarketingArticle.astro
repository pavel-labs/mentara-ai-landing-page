---
import BaseLayout from '../layouts/BaseLayout.astro';
import { localeHome, localePath } from '../i18n';
import { SITE } from '../consts';
import type { IMarketingPublishedArticle } from '../marketing/types.generated';
import { marketingLabels } from '../marketing/content';
import '../marketing/styles.css';
import '../styles/reading.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import ArticleBlocks from './ArticleBlocks.astro';
interface Props {
  article: IMarketingPublishedArticle;
}
const { article } = Astro.props;
const labels = marketingLabels(article.locale);
const url = new URL(
  localePath(article.locale, `articles/${article.slug}`),
  Astro.site ?? SITE.domain,
).href;
const jsonLd = [
  {
    '@type': 'Article',
    headline: article.title,
    description: article.excerpt,
    datePublished: article.publishedAt,
    author: { '@type': 'Person', name: article.author },
    publisher: { '@id': `${new URL(url).origin}/#org` },
    mainEntityOfPage: url,
    inLanguage: article.locale,
    ...(article.cover ? { image: article.cover.url } : {}),
  },
];
---

<BaseLayout
  locale={article.locale}
  title={article.seo.title}
  description={article.seo.description}
  ogImageUrl={article.seo.image?.url ?? article.cover?.url}
  ogType="article"
  suppressAlternates
  jsonLd={jsonLd}
>
  <Nav locale={article.locale} homeHref={localeHome(article.locale)} />
  <main id="main" class="cms-article reading-shell" data-marketing-article>
    <a class="link-arrow" href={localePath(article.locale, 'articles')}>
      ← {labels.articles}
    </a>
    <header class="reading-header">
      <p class="mono">
        {article.author} ·{' '}
        <time datetime={article.publishedAt}>{article.publishedAt.slice(0, 10)}</time>
      </p>
      <h1 class="reading-title">{article.title}</h1>
      <p class="reading-summary">{article.excerpt}</p>
      <div class="cms-tags">
        {article.tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
      {article.cover && (
        <img
          src={article.cover.url}
          alt={article.cover.alt}
          width="960"
          height="540"
          fetchpriority="high"
        />
      )}
    </header>
    <ArticleBlocks blocks={article.blocks} />
  </main>
  <Footer locale={article.locale} />
</BaseLayout>
