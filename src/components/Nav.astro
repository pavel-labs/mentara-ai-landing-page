---
import { SITE } from '../consts';
import { getDict, resolveNavHref, type Locale } from '../i18n';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  homeHref?: string;
}
const { locale, homeHref = '#main' } = Astro.props;
const t = getDict(locale);
const resolveHref = (href: string) => resolveNavHref(locale, homeHref, href);
---

<header class="nav">
  <div class="container nav__row">
    <a href={homeHref} class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand__mark" aria-hidden="true">M</span>
      <span class="brand__word">{SITE.name}</span>
    </a>

    <nav class="links" aria-label="Primary">
      {t.nav.map((l) => <a href={resolveHref(l.href)}>{l.label}</a>)}
    </nav>

    <div class="nav__end">
      <LanguageSwitcher locale={locale} />
      <span class="pill">
        <span class="dot" aria-hidden="true"></span>
        {t.meta.launchLabel}
      </span>

      {/*
        Narrow-screen navigation. Built on <details> so it opens, closes and takes
        keyboard focus natively – no JS needed for the core behaviour, which also means
        it still works if the enhancement script fails to load.
      */}
      <details class="menu">
        <summary class="menu__btn" aria-label={t.a11yMenu}>
          <span class="menu__bars" aria-hidden="true"></span>
        </summary>
        <div class="menu__panel">
          <nav aria-label={t.a11yMenu}>
            {t.nav.map((l) => <a href={resolveHref(l.href)}>{l.label}</a>)}
          </nav>
          {/* Five locales no longer fit next to the brand on a phone, so on the
              narrowest screens the switcher moves in here instead of overflowing. */}
          <div class="menu__lang">
            <LanguageSwitcher locale={locale} />
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

{/*
  Enhancement only: close the sheet after picking a link (an in-page anchor does not
  reload, so <details> would stay open over the target) and on Escape.
*/}
<script>
  document.querySelectorAll<HTMLDetailsElement>('details.menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('.menu__panel a')) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector<HTMLElement>('.menu__btn')?.focus();
      }
    });
  });
</script>

<style>
  .nav__end {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: none;
  }
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(14px) saturate(140%);
    background: color-mix(in oklab, var(--ink) 72%, transparent);
    border-bottom: 1px solid var(--line);
  }
  .nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 4.4rem;
  }
  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
  }
  .brand__mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    background: var(--amber);
    width: 1.85rem;
    height: 1.85rem;
    display: grid;
    place-items: center;
    border-radius: 8px;
    transform: translateY(0.25rem);
  }
  .brand__word {
    font-family: var(--font-display);
    font-weight: 610;
    font-size: 1.2rem;
    letter-spacing: -0.02em;
  }
  .links {
    display: flex;
    gap: 2rem;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--bone-dim);
  }
  .links a {
    position: relative;
    padding-block: 0.3rem;
    transition: color 0.2s;
  }
  .links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 1px;
    background: var(--amber);
    transition: width 0.28s var(--ease);
  }
  .links a:hover {
    color: var(--bone);
  }
  .links a:hover::after {
    width: 100%;
  }
  /* ---- narrow-screen menu ---- */
  .menu {
    display: none;
    position: relative;
  }
  .menu__btn {
    list-style: none;
    cursor: pointer;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }
  .menu__btn::-webkit-details-marker {
    display: none;
  }
  /* Three bars drawn from one element: the middle is the box, the outer two its
     pseudo-elements. Turns into an X while the sheet is open. */
  .menu__bars,
  .menu__bars::before,
  .menu__bars::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--bone);
    transition: transform 0.2s var(--ease);
  }
  .menu__bars::before,
  .menu__bars::after {
    content: '';
    position: relative;
  }
  .menu__bars::before {
    top: -0.42rem;
  }
  .menu__bars::after {
    top: 0.3rem;
  }
  .menu[open] .menu__bars {
    background: transparent;
  }
  .menu[open] .menu__bars::before {
    transform: translateY(0.42rem) rotate(45deg);
  }
  .menu[open] .menu__bars::after {
    transform: translateY(-0.3rem) rotate(-45deg);
  }
  .menu__panel {
    position: absolute;
    top: calc(100% + 0.7rem);
    right: 0;
    min-width: 12rem;
    padding: 0.5rem;
    background: var(--ink-1);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
  }
  .menu__panel nav {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  /* Shown only while the in-bar switcher is hidden (see the 560px breakpoint). */
  .menu__lang {
    display: none;
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
  .menu__panel a {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--bone-dim);
    padding: 0.6rem 0.7rem;
    border-radius: 2px;
  }
  .menu__panel a:hover {
    color: var(--bone);
    background: rgba(236, 231, 221, 0.05);
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__bars,
    .menu__bars::before,
    .menu__bars::after {
      transition: none;
    }
  }

  @media (max-width: 820px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }

  /* Brand + 5-locale switcher + menu button stop fitting on a phone-width bar. */
  @media (max-width: 560px) {
    .nav__end > :global(.lang) {
      display: none;
    }
    .menu__lang {
      display: block;
    }
  }
  /* The pill carries the long localized launch label ("Disponible en 2026"). Drop it
     once links + the 4-segment switcher are sharing the bar, so they never collide on
     mid-width desktops in the longer languages. It stays prominent in the hero/footer. */
  @media (max-width: 1024px) {
    .pill {
      display: none;
    }
  }
</style>
