---
import { getDict, type Locale } from '../i18n';
import { marketingLabels, marketingLinks } from '../marketing/content';
import type { IMarketingLinks } from '../marketing/types.generated';
interface Props { locale: Locale; links?: IMarketingLinks }
const { locale, links = marketingLinks(locale) } = Astro.props;
const b = getDict(locale).badges;
const labels = marketingLabels(locale);
const badges = [
  { label: b.ios, glyph: 'iOS', url: links.appStoreUrl, event: 'app_store_cta' },
  { label: b.android, glyph: '▶', url: links.googlePlayUrl, event: 'google_play_cta' },
  { label: b.web, glyph: '◎', url: links.webAppUrl, event: 'web_app_cta' },
];
---
<div class="badges" role="group" aria-label={b.ariaGroup}>
  {badges.map((badge) => badge.url ?
    <a class="badge" href={badge.url} data-marketing-event={badge.event} rel="noopener noreferrer">
      <span class="badge__glyph" aria-hidden="true">{badge.glyph}</span>
      <span class="badge__text"><small>{labels.available}</small><strong>{badge.label}</strong></span>
    </a> :
    <span class="badge" aria-disabled="true">
      <span class="badge__glyph" aria-hidden="true">{badge.glyph}</span>
      <span class="badge__text"><small>{b.comingSoon}</small><strong>{badge.label}</strong></span>
    </span>
  )}
</div>

<style>
  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  /* Three "coming soon" badges. flex-basis gives a tidy row; min-width:0 lets them
     shrink/wrap WITHIN the column instead of overflowing it – `min-width:max-content`
     here previously forced the row to bleed over the hero panel in longer locales. */
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    flex: 1 1 8.5rem;
    min-width: 0;
    padding: 0.6rem 0.95rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: rgba(236, 231, 221, 0.02);
    color: var(--bone);
    text-decoration: none;
    user-select: none;
    transition: border-color 0.25s var(--ease);
  }
  .badge[aria-disabled="true"] { cursor: not-allowed; opacity: .65; }
  .badge:hover {
    border-color: var(--bone-faint);
  }
  .badge__glyph {
    width: 1.4rem;
    height: 1.4rem;
    color: var(--bone-dim);
    flex: none;
  }
  .badge__text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .badge__text small {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bone-faint);
  }
  .badge__text strong {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
</style>
