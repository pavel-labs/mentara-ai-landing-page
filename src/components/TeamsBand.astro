---
import { getDict, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tb = getDict(locale).teamsBand;
---

<section class="teams" aria-labelledby="teams-title">
  <div class="container">
    <div class="teams__panel">
      <div class="teams__head">
        <p class="eyebrow">{tb.eyebrow}</p>
        <h2 id="teams-title" class="h2">{tb.heading}</h2>
        <p class="lede">{tb.lede}</p>
        <a class="btn btn--ghost" href={localePath(locale, 'enterprise')}>{tb.cta} →</a>
      </div>
      <ul class="points teams__points">
        {
          tb.points.map((p) => (
            <li>
              <h3>{p.title}</h3>
              <p>{p.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .teams__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    padding: clamp(1.6rem, 4vw, 3rem);
    border: 1px solid var(--line-strong);
    border-top: 2px solid var(--sage);
    border-radius: var(--radius-lg);
    background: var(--ink-1);
  }
  .teams__head {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    align-items: flex-start;
    min-width: 0;
  }
  .teams__head .h2 {
    font-size: clamp(1.7rem, 1.2rem + 1.8vw, 2.5rem);
  }
  .teams__head .lede {
    font-size: 1.05rem;
  }
  .teams__points {
    grid-template-columns: minmax(0, 1fr);
    align-self: center;
  }
  .teams__points li {
    background: var(--ink-1);
  }
  @media (max-width: 900px) {
    .teams__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
