---
import { getDict, localePath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const tb = getDict(locale).teamsBand;
---

<section class="teams" aria-labelledby="teams-title">
  <div class="container">
    <div class="teams__panel theme-dark">
      <div class="teams__head">
        <p class="eyebrow">{tb.eyebrow}</p>
        <h2 id="teams-title" class="h2">
          {tb.heading}
        </h2>
        <p class="lede">{tb.lede}</p>
        <a class="btn btn--accent" href={localePath(locale, 'enterprise')}>
          {tb.cta} →
        </a>
      </div>
      <ul class="points teams__points">
        {tb.points.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .teams {
    padding-block: 0 var(--section-space);
  }
  .teams__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    padding: clamp(2rem, 5vw, 5rem);
    border-radius: var(--radius-lg);
    background: #193629;
  }
  .teams__head {
    display: grid;
    justify-items: start;
    gap: 1.5rem;
    min-width: 0;
  }
  .teams__head .h2 {
    font-size: clamp(2rem, 3.7vw, 3.5rem);
  }
  .teams__head .lede {
    font-size: 1.0625rem;
  }
  .teams__points {
    grid-template-columns: minmax(0, 1fr);
  }
  .teams__points li {
    padding: 1.5rem 0;
    border-radius: 0;
    border-bottom: 1px solid var(--line);
    background: transparent;
  }
  .teams__points h3 {
    color: var(--accent-ink);
  }
  @media (max-width: 900px) {
    .teams__panel {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
