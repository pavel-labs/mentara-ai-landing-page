---
import { getDict, type Locale } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const w = getDict(locale).why;
---

<section id="why">
  <div class="container">
    <SectionHead eyebrow={w.eyebrow} heading={w.heading} />
    <p class="lede why__lede">{w.lede}</p>

    <div class="vs">
      <div class="vs__col">
        <h3 class="vs__name">{w.them.label}</h3>
        <ul>
          {
            w.them.points.map((p) => (
              <li>
                <span class="vs__mark" aria-hidden="true">–</span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="vs__col vs__col--us">
        <h3 class="vs__name">{w.us.label}</h3>
        <ul>
          {
            w.us.points.map((p) => (
              <li>
                <span class="vs__mark" aria-hidden="true">✓</span>
                {p}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .why__lede {
    max-width: 60ch;
    margin-top: calc(-1 * clamp(1rem, 2.5vw, 2rem));
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .vs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .vs__col {
    padding: clamp(1.4rem, 3vw, 2.2rem);
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    min-width: 0;
  }
  .vs__col--us {
    background: var(--ink-1);
    border-left: 1px solid var(--line-strong);
    box-shadow: inset 0 2px 0 var(--amber);
  }
  .vs__name {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--bone-dim);
  }
  .vs__col--us .vs__name {
    color: var(--amber);
  }
  .vs ul {
    list-style: none;
    display: grid;
    gap: 0.9rem;
  }
  .vs li {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: 0.4rem;
    color: var(--bone-dim);
  }
  .vs__col--us li {
    color: var(--bone);
  }
  .vs__mark {
    color: var(--bone-faint);
  }
  .vs__col--us .vs__mark {
    color: var(--amber);
  }
  @media (max-width: 760px) {
    .vs {
      grid-template-columns: minmax(0, 1fr);
    }
    .vs__col--us {
      border-left: 0;
      border-top: 1px solid var(--line-strong);
    }
  }
</style>
