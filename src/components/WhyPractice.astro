---
import { getDict, type Locale } from '../i18n';
import SectionHead from './SectionHead.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const w = getDict(locale).why;
---

<section id="why">
  <div class="container">
    <SectionHead eyebrow={w.eyebrow} heading={w.heading} />
    <p class="lede why__lede">{w.lede}</p>

    <div class="vs">
      <div class="vs__col">
        <h3 class="vs__name">{w.them.label}</h3>
        <ul>
          {w.them.points.map((p) => (
            <li>
              <span class="vs__mark" aria-hidden="true">
                –
              </span>
              {p}
            </li>
          ))}
        </ul>
      </div>
      <div class="vs__col vs__col--us">
        <h3 class="vs__name">{w.us.label}</h3>
        <ul>
          {w.us.points.map((p) => (
            <li>
              <span class="vs__mark" aria-hidden="true">
                ✓
              </span>
              {p}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .why__lede {
    max-width: 65ch;
    margin-top: -1rem;
    margin-bottom: 3rem;
  }
  .vs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .vs__col {
    display: grid;
    align-content: start;
    gap: 1.75rem;
    min-width: 0;
    padding: clamp(1.75rem, 4vw, 3.5rem);
    border-radius: var(--radius-lg);
    background: var(--surface-subtle);
  }
  .vs__col--us {
    background: #e2edcf;
  }
  .vs__name {
    max-width: 23ch;
    font-size: clamp(1.4rem, 2.5vw, 2rem);
  }
  .vs ul {
    display: grid;
    gap: 1.1rem;
    padding: 0;
    list-style: none;
  }
  .vs li {
    display: grid;
    grid-template-columns: 1.1rem minmax(0, 1fr);
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .vs__col--us li {
    color: var(--text);
  }
  .vs__mark {
    color: var(--text-soft);
  }
  .vs__col--us .vs__mark {
    color: var(--accent-ink);
    font-weight: 700;
  }
  @media (max-width: 760px) {
    .vs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
