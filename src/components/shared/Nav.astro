---
import { SITE } from '../../consts';
import { getDict, resolveNavHref, type Locale } from '../../i18n';
import { marketingLanding, marketingLabels } from '../../marketing/content';
import BrandMark from './BrandMark.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
  homeHref?: string;
}
const { locale, homeHref = '#main' } = Astro.props;
const t = getDict(locale);
const content = marketingLanding(locale);
const labels = marketingLabels(locale);
const nav = content
  ? [
      { label: labels.products, href: '#product' },
      { label: t.pricing.eyebrow, href: '#pricing' },
      { label: labels.articles, href: '/articles' },
    ]
  : [...t.nav, { label: labels.articles, href: '/articles' }];
const resolveHref = (href: string) => resolveNavHref(locale, homeHref, href);
const eventFor = (href: string) =>
  href === '#pricing'
    ? 'pricing_cta'
    : href.startsWith('/enterprise')
      ? 'enterprise_cta'
      : undefined;
---

<header class="nav">
  <div class="container nav__row">
    <a href={homeHref} class="brand" aria-label={`${SITE.name} home`}>
      <span class="brand__mark">
        <BrandMark />
      </span>
      <span>{SITE.name}</span>
    </a>
    <nav class="links" aria-label="Primary">
      {nav.map((link) => (
        <a href={resolveHref(link.href)} data-marketing-event={eventFor(link.href)}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="nav__end">
      <LanguageSwitcher locale={locale} />
      <span class="pill nav__launch">
        <span class="dot" aria-hidden="true"></span>
        {t.meta.launchLabel}
      </span>
      <details class="menu">
        <summary class="menu__btn" aria-label={t.a11yMenu}>
          <span class="menu__bars" aria-hidden="true"></span>
        </summary>
        <div class="menu__panel">
          <nav aria-label={t.a11yMenu}>
            {nav.map((link) => (
              <a href={resolveHref(link.href)} data-marketing-event={eventFor(link.href)}>
                {link.label}
              </a>
            ))}
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('.menu__panel a')) menu.open = false;
    });
    document.addEventListener('click', (event) => {
      if (!menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !menu.open) return;
      menu.open = false;
      menu.querySelector<HTMLElement>('summary')?.focus();
    });
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .nav__row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    min-height: 5rem;
  }
  .brand {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.55rem;
    font-weight: 750;
    letter-spacing: -0.065em;
  }
  .brand__mark {
    width: 1.8rem;
    color: var(--accent-ink);
  }
  .links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 2vw, 1.8rem);
    font-size: 0.875rem;
    font-weight: 500;
  }
  .links a {
    padding-block: 0.8rem;
    text-align: center;
    line-height: 1.35;
  }
  .links a:hover {
    color: var(--accent-ink);
  }
  .nav__end {
    display: flex;
    flex: none;
    align-items: center;
    gap: 1rem;
  }
  .nav__launch {
    max-width: 13rem;
  }
  .menu {
    display: none;
  }
  .menu__btn {
    list-style: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
  }
  .menu__btn::-webkit-details-marker {
    display: none;
  }
  .menu__bars,
  .menu__bars::after {
    display: block;
    width: 1.1rem;
    height: 1.5px;
    background: var(--text);
  }
  .menu__bars {
    transform: translateY(-3px);
  }
  .menu__bars::after {
    content: '';
    transform: translateY(6px);
  }
  .menu[open] .menu__bars {
    transform: rotate(45deg);
  }
  .menu[open] .menu__bars::after {
    transform: rotate(-90deg);
  }
  .menu__panel {
    position: absolute;
    top: calc(100% - 1px);
    inset-inline: 0;
    padding: 1.25rem var(--gutter) 1.5rem;
    background: var(--surface);
    border-bottom: 1px solid var(--line-strong);
    box-shadow: 0 24px 32px -24px #18201930;
  }
  .menu__panel nav {
    display: grid;
    gap: 0.3rem;
  }
  .menu__panel a {
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.15rem;
    font-weight: 550;
  }
  @media (max-width: 1200px) {
    .nav__launch {
      display: none;
    }
  }
  @media (max-width: 1000px) {
    .links {
      display: none;
    }
    .menu {
      display: block;
    }
  }
  @media (max-width: 520px) {
    .nav__row {
      min-height: 4.5rem;
      gap: 0.5rem;
    }
    .brand {
      font-size: 1.35rem;
    }
    .nav__end {
      gap: 0.4rem;
    }
  }
</style>
