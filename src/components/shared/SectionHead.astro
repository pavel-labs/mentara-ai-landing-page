---
interface Props {
  eyebrow: string;
  heading: string;
  class?: string;
  preview?: string;
}
const { eyebrow, heading, class: className, preview } = Astro.props;
---

<div class:list={['section-head', className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 class="h2" data-preview={preview}>
    {heading}
  </h2>
</div>
