---
import type { Locale } from '../../i18n/index';
import { getDict, localePath } from '../../i18n/index';
import { getPublishedPosts, formatPostDate } from '../../content/blog';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDict(locale);

const posts = (await getPublishedPosts()).slice(0, 4);
---

<section class="journal" aria-labelledby="journal-title">
  <div class="container journal__inner">
    <div class="journal__head">
      <p class="eyebrow">{t.contentHub.blog.eyebrow}</p>
      <div class="journal__copy">
        <h2 id="journal-title" class="h2">
          {t.contentHub.blog.title}
        </h2>
        <p class="journal__lede">{t.contentHub.blog.lede}</p>
      </div>
      <a class="journal__all" href={localePath(locale, 'blog')}>
        {t.contentHub.blog.primary} →
      </a>
    </div>

    <div class="journal__grid">
      {posts.map((post) => (
        <article class="journal__card">
          <a href={localePath(locale, `blog/${post.id}`)} class="journal__link">
            <time class="journal__date mono" datetime={post.data.date.toISOString()}>
              {formatPostDate(post.data.date)}
            </time>
            <h3 class="journal__title">{post.data.title}</h3>
            <p class="journal__summary">{post.data.summary}</p>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .journal {
    background: var(--surface-subtle);
  }
  .journal__inner {
    display: grid;
    gap: 3rem;
  }
  .journal__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.5rem 3rem;
    align-items: end;
  }
  .journal__head > .eyebrow {
    grid-column: 1 / -1;
  }
  .journal__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 50rem;
  }
  .journal__lede {
    max-width: 56ch;
    color: var(--text-muted);
  }
  .journal__all {
    justify-self: start;
    color: var(--accent-ink);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .journal__all:hover {
    text-decoration: underline;
  }
  .journal__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .journal__card {
    min-width: 0;
    border-radius: 24px;
    background: var(--surface-raised);
    overflow: hidden;
  }
  .journal__link {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100%;
    padding: clamp(1.5rem, 3vw, 2.5rem);
  }
  .journal__link::before {
    content: '↗';
    display: grid;
    place-items: center;
    align-self: flex-end;
    width: 3rem;
    height: 3rem;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: var(--surface-subtle);
    color: var(--accent-ink);
    font-size: 1.5rem;
    transition: background 180ms ease;
  }
  .journal__card:nth-child(2) .journal__link::before {
    background: var(--accent);
  }
  .journal__card:nth-child(3) .journal__link::before {
    background: #dce9f0;
  }
  .journal__link:hover::before {
    background: var(--accent);
  }
  .journal__date {
    font-size: 0.75rem;
  }
  .journal__title {
    max-width: 28ch;
    font-size: clamp(1.5rem, 2.5vw, 2rem);
    letter-spacing: -0.035em;
  }
  .journal__summary {
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  @media (max-width: 760px) {
    .journal__head,
    .journal__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
