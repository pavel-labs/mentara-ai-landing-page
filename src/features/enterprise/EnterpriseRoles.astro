---
import { getDict, type Locale } from '../../i18n';
import SectionHead from '../../components/shared/SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const enterprise = getDict(locale).enterprise;
---

<section class="ent-roles">
  <div class="container split ent-roles__split">
    <div class="split__copy">
      <SectionHead eyebrow={enterprise.roles.eyebrow} heading={enterprise.roles.heading} />
      <dl class="ent-roles__list">
        {enterprise.roles.items.map((item) => (
          <div class="ent-roles__row">
            <dt>{item.role}</dt>
            <dd>{item.body}</dd>
          </div>
        ))}
      </dl>
    </div>
    <aside class="ent-roles__planned" aria-labelledby="notyet-title">
      <h3 id="notyet-title" class="ent-roles__planned-title">
        {enterprise.notYet.heading}
      </h3>
      <p class="ent-roles__planned-lede">{enterprise.notYet.lede}</p>
      <ul class="ent-roles__planned-list">
        {enterprise.notYet.items.map((item) => (
          <li class="ent-roles__planned-item">{item}</li>
        ))}
      </ul>
    </aside>
  </div>
</section>

<style>
  .ent-roles {
    border-block: 1px solid var(--line);
    background: var(--surface-subtle);
  }
  .ent-roles__split {
    align-items: start;
  }
  .ent-roles__list {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .ent-roles__row {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .ent-roles__row dt {
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.82rem;
  }
  .ent-roles__row dd {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .ent-roles__planned {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    padding: clamp(1.4rem, 3vw, 2rem);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
  }
  .ent-roles__planned-title {
    font-size: 1.2rem;
  }
  .ent-roles__planned-lede {
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .ent-roles__planned-list {
    display: grid;
    gap: 0.5rem;
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    list-style: none;
  }
  .ent-roles__planned-item::before {
    color: var(--text-soft);
    content: '○ ';
  }

  @media (max-width: 820px) {
    .ent-roles__row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.25rem;
    }
  }
</style>
