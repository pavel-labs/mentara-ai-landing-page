---
import { getDict, type Locale } from '../../i18n';
import SectionHead from '../../components/shared/SectionHead.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const useCases = getDict(locale).enterprise.useCases;
---

<section class="ent-cases">
  <div class="container">
    <SectionHead eyebrow={useCases.eyebrow} heading={useCases.heading} />
    <div class="ent-cases__grid">
      {useCases.items.map((useCase) => (
        <article class="ent-cases__card">
          <span class="ent-cases__tag">{useCase.tag}</span>
          <h3 class="ent-cases__title">{useCase.title}</h3>
          <p class="ent-cases__body">{useCase.body}</p>
          <ul class="ent-cases__points">
            {useCase.points.map((point) => (
              <li class="ent-cases__point">
                <span aria-hidden="true">✓</span>
                {point}
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .ent-cases__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .ent-cases__card {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
    padding: clamp(1.4rem, 3vw, 2.2rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-raised);
  }
  .ent-cases__tag {
    align-self: flex-start;
    padding: 0.25rem 0.55rem;
    border: 1px solid color-mix(in oklab, var(--accent-ink) 40%, transparent);
    border-radius: 2px;
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ent-cases__title {
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
  }
  .ent-cases__body {
    color: var(--text-muted);
  }
  .ent-cases__points {
    display: grid;
    gap: 0.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .ent-cases__point {
    display: grid;
    grid-template-columns: 1.2rem minmax(0, 1fr);
    gap: 0.4rem;
    font-size: 0.95rem;
  }
  .ent-cases__point span {
    color: var(--accent-ink);
  }

  @media (max-width: 820px) {
    .ent-cases__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
