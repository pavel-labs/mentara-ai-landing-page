---
import { getDict, type Locale } from '../../i18n/index';
import SectionHead from '../../components/shared/SectionHead.astro';
interface Props {
  locale: Locale;
  items?: { q: string; a: string }[];
  heading?: string;
}
const {
  locale,
  items = getDict(locale).faq.items,
  heading = getDict(locale).faq.heading,
} = Astro.props;
const faq = getDict(locale).faq;
---

{items.length > 0 && (
  <section id="faq">
    <div class="container faq__grid">
      <SectionHead eyebrow={faq.eyebrow} heading={heading} class="faq__head" />
      <div class="faq__list" data-preview="faq">
        {items.map((item) => (
          <details class="qa">
            <summary>
              <span>{item.q}</span>
              <span class="qa__sign" aria-hidden="true"></span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}
<style>
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }
  .faq__head {
    position: sticky;
    top: 7rem;
    margin-bottom: 0;
  }
  .qa {
    border-top: 1px solid var(--line);
  }
  .qa:last-child {
    border-bottom: 1px solid var(--line);
  }
  .qa summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.6rem 0;
    list-style: none;
    font-size: 1.125rem;
    font-weight: 550;
    line-height: 1.4;
    cursor: pointer;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa__sign {
    position: relative;
    flex: none;
    width: 1.8rem;
    height: 1.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
  }
  .qa__sign::before,
  .qa__sign::after {
    content: '';
    position: absolute;
    top: calc(50% - 0.5px);
    left: 0.5rem;
    right: 0.5rem;
    height: 1px;
    background: var(--text);
  }
  .qa__sign::after {
    transform: rotate(90deg);
    transition: transform 180ms ease;
  }
  .qa[open] .qa__sign::after {
    transform: rotate(0);
  }
  .qa p {
    max-width: 65ch;
    padding: 0 2.5rem 1.6rem 0;
    color: var(--text-muted);
    line-height: 1.7;
  }
  @media (max-width: 760px) {
    .faq__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .faq__head {
      position: static;
    }
  }
</style>
