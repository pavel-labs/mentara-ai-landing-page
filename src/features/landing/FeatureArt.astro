---
import type { IMarketingFeature } from '../../marketing/types.generated';
interface Props {
  kind: IMarketingFeature['id'];
}
const { kind } = Astro.props;
---

<div class:list={['feature-art', `feature-art--${kind}`]} aria-hidden="true">
  {kind === 'mock-interviews' ? (
    <div class="art-wave">
      {[3, 6, 10, 7, 13, 8, 11, 5, 8, 4].map((height) => (
        <i style={`--height:${height}`} />
      ))}
    </div>
  ) : kind === 'coding-assessments' ? (
    <div class="art-code">
      <span>{'{ '}</span>
      <i>✓</i>
      <span>{' }'}</span>
    </div>
  ) : kind === 'progress' ? (
    <div class="art-steps">
      {[1, 2, 3, 4, 5].map((step) => (
        <i style={`--step:${step}`} />
      ))}
      <span>↗</span>
    </div>
  ) : kind === 'enterprise' ? (
    <div class="art-team">
      {[0, 1, 2].map((member) => (
        <span style={`--member:${member}`}>
          <i></i>
        </span>
      ))}
    </div>
  ) : (
    <div class="art-practice">
      <span>?</span>
      <span>✓</span>
      <span>↗</span>
    </div>
  )}
</div>
<style>
  .feature-art {
    display: grid;
    place-items: center;
    min-height: 16rem;
    padding: 2rem 1rem;
    overflow: hidden;
  }
  .art-wave {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 2.5rem;
    border-radius: 50%;
    background: var(--accent);
  }
  .art-wave i {
    width: 0.5rem;
    height: calc(var(--height) * 0.65rem);
    background: #193629;
    border-radius: 1rem;
  }
  .art-code {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transform: rotate(-8deg);
  }
  .art-code > span {
    color: #436677;
    font: 400 8rem/1 var(--font-mono);
    letter-spacing: -0.15em;
  }
  .art-code i {
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 50%;
    background: #fff;
    color: #2f5e43;
    font: 500 2.5rem var(--font-body);
    box-shadow: 0 12px 24px #37536a20;
  }
  .art-steps {
    display: flex;
    align-items: flex-end;
    gap: 0.65rem;
    height: 11rem;
    position: relative;
  }
  .art-steps i {
    width: 2.2rem;
    height: calc(var(--step) * 1.7rem);
    border-radius: 9px 9px 3px 3px;
    background: #b3c4a6;
  }
  .art-steps i:last-of-type {
    background: #244a32;
  }
  .art-steps span {
    position: absolute;
    top: -1.5rem;
    left: 1rem;
    color: #244a32;
    font-size: 6rem;
    line-height: 1;
  }
  .art-practice {
    position: relative;
    width: 16rem;
    height: 12rem;
  }
  .art-practice span {
    position: absolute;
    display: grid;
    place-items: center;
    width: 8rem;
    height: 10rem;
    border: 1px solid #bdce9d;
    border-radius: 20px;
    background: #f4fae9;
    color: #314b27;
    font-size: 4rem;
    font-weight: 600;
    box-shadow: 0 16px 30px #2c462210;
  }
  .art-practice span:first-child {
    left: 0;
    transform: rotate(-18deg);
  }
  .art-practice span:nth-child(2) {
    left: 4rem;
    top: 1rem;
    transform: rotate(5deg);
    background: var(--accent);
  }
  .art-practice span:last-child {
    left: 8rem;
    top: 2rem;
    transform: rotate(20deg);
    background: #234b33;
    color: var(--accent);
  }
  .art-team {
    display: flex;
    align-items: center;
    padding-left: 1.5rem;
  }
  .art-team > span {
    display: grid;
    place-items: center;
    width: 6rem;
    height: 8rem;
    margin-left: -1.5rem;
    border: 1px solid #697d5b;
    border-radius: 40px 40px 20px 20px;
    background: #2d4834;
    transform: translateY(calc(var(--member) * -0.75rem)) rotate(calc(var(--member) * 9deg - 9deg));
  }
  .art-team > span:nth-child(2) {
    background: var(--accent);
  }
  .art-team i {
    position: relative;
    width: 1.6rem;
    height: 1.6rem;
    margin-top: -1.2rem;
    border-radius: 50%;
    background: #a4b693;
  }
  .art-team i::after {
    content: '';
    position: absolute;
    top: 2rem;
    left: -0.65rem;
    width: 2.9rem;
    height: 1.9rem;
    border-radius: 50% 50% 8px 8px;
    background: inherit;
  }
  .art-team > span:nth-child(2) i {
    background: #234330;
  }
  @media (max-width: 600px) {
    .feature-art {
      min-height: 13rem;
    }
    .art-wave {
      transform: scale(0.8);
    }
  }
</style>
