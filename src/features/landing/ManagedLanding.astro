---
import '../../marketing/styles.css';
import { marketingLabels } from '../../marketing/content';
import { getDict, localePath } from '../../i18n/index';
import type { IMarketingLanding } from '../../marketing/types.generated';
import Hero from './Hero.astro';
import Proof from './Proof.astro';
import FeatureArt from './FeatureArt.astro';
import Pricing from './Pricing.astro';
import FAQ from './FAQ.astro';
interface Props {
  content: IMarketingLanding;
}
const { content } = Astro.props;
const labels = marketingLabels(content.locale);
const t = getDict(content.locale);
---

<Hero locale={content.locale} content={content} />
<Proof locale={content.locale} />
<section class="container cms-section" id="product">
  <p class="eyebrow">
    {t.interview.eyebrow} · {t.assessment.eyebrow}
  </p>
  <h2 class="h2">{labels.products}</h2>
  <div class="cms-features" data-preview="features">
    {content.features
      .filter((feature) => feature.enabled)
      .map((feature, index) => (
        <article
          class:list={[
            'cms-feature',
            `cms-feature--${feature.id}`,
            {
              theme: feature.id === 'enterprise',
              'theme--dark': feature.id === 'enterprise',
            },
          ]}
          id={feature.id}
        >
          <div class="cms-feature__copy">
            <span class="cms-feature__number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
            {feature.id === 'enterprise' && (
              <a
                class="btn btn--accent"
                href={localePath(content.locale, 'enterprise')}
                data-marketing-event="enterprise_cta"
              >
                {labels.contact}
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
          {feature.image ? (
            <img
              class="cms-feature__image"
              src={feature.image.url}
              alt={feature.image.alt}
              width="640"
              height="400"
              loading="lazy"
            />
          ) : (
            <FeatureArt kind={feature.id} />
          )}
        </article>
      ))}
  </div>
</section>
<Pricing locale={content.locale} content={content} />
<FAQ
  locale={content.locale}
  items={content.faq
    .filter((item) => item.enabled)
    .map((item) => ({ q: item.question, a: item.answer }))}
  heading={labels.faq}
/>
