---
import { getDict, resolveNavHref, type Locale } from '../../i18n/index';
import { marketingSnapshot, marketingLabels } from '../../marketing/content';
import type { IMarketingLanding } from '../../marketing/types.generated';
import SectionHead from '../../components/shared/SectionHead.astro';
interface Props {
  locale: Locale;
  content?: IMarketingLanding;
}
const { locale, content } = Astro.props;
const pricing = getDict(locale).pricing;
const labels = marketingLabels(locale);
const prices = marketingSnapshot.pricing?.displayPrices;
const descriptions = content
  ? [
      content.pricing.freeDescription,
      content.pricing.proDescription,
      content.pricing.enterpriseDescription,
    ]
  : [];
const tiers = pricing.tiers.map((tier, index) => {
  const isPro = index === 1;
  const proPrice = prices?.proMonthly ?? labels.prices;
  if (!content) {
    return {
      ...tier,
      ...(isPro ? { price: proPrice, cadence: prices ? labels.month : '' } : {}),
    };
  }
  return {
    ...tier,
    price: ['$0', proPrice, labels.contact][index] ?? '',
    cadence: isPro && prices ? labels.month : '',
    blurb: descriptions[index] ?? '',
    features: [],
    cta: index === 2 ? labels.contact : content.hero.ctaLabel,
    href: index === 2 ? '/enterprise#contact' : content.links.webAppUrl,
  };
});
const hrefFor = (href: string) =>
  href.startsWith('https://') ? href : resolveNavHref(locale, '#main', href);
---

<section id="pricing" class="pricing">
  <div class="container">
    <SectionHead
      preview={content ? 'pricing.heading' : undefined}
      eyebrow={pricing.eyebrow}
      heading={content?.pricing.heading ?? pricing.heading}
    />
    <div class="tiers">
      {tiers.map((plan, index) => (
        <article class:list={['tier', { 'tier--hot': plan.featured }]}>
          <header class="tier__head">
            <div class="tier__top">
              <h3 class="tier__name">{plan.tier}</h3>
              {plan.featured && <span class="tier__flag">{pricing.flag}</span>}
            </div>
            <div class="tier__price">
              <span class="tier__amt">{plan.price}</span>
              {plan.cadence && <span class="tier__cad">{plan.cadence}</span>}
            </div>
            <p
              class="tier__blurb"
              data-preview={
                content
                  ? `pricing.${['freeDescription', 'proDescription', 'enterpriseDescription'][index]}`
                  : undefined
              }
            >
              {plan.blurb}
            </p>
          </header>
          {plan.features.length > 0 && (
            <ul class="tier__list">
              {plan.features.map((feature) => (
                <li>
                  <span class="chk" aria-hidden="true">
                    ✓
                  </span>
                  {feature}
                </li>
              ))}
            </ul>
          )}
          {plan.href && (
            <a
              class:list={['btn', 'tier__cta', { 'btn--ghost': !plan.featured }]}
              href={hrefFor(plan.href)}
              data-marketing-event={index === 2 ? 'enterprise_cta' : 'pricing_cta'}
            >
              {plan.cta}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
    <p class="mono tiers__foot" data-preview="pricing.description">
      {content?.pricing.description ?? pricing.foot}
    </p>
  </div>
</section>
<style>
  .pricing {
    background: var(--surface-subtle);
  }
  .pricing :global(.section-head) {
    margin-inline: auto;
    text-align: center;
    justify-items: center;
  }
  .tiers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }
  .tier {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid transparent;
    border-radius: 24px;
    background: var(--surface-raised);
  }
  .tier--hot {
    background: #e1efc9;
    border-color: #c3d6a7;
  }
  .tier__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    min-height: 2rem;
  }
  .tier__name {
    font-size: 1.5rem;
    letter-spacing: -0.04em;
  }
  .tier__flag {
    padding: 0.3rem 0.65rem;
    border-radius: 999px;
    background: #cee2af;
    color: #344c2c;
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .tier__price {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    margin-top: 1.5rem;
    min-height: 6.5rem;
  }
  .tier__amt {
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.06em;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }
  .tier__cad {
    font-size: 0.75rem;
    color: var(--text-soft);
  }
  .tier__blurb {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }
  .tier__list {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 1.5rem 0 0;
    border-top: 1px solid var(--line);
    list-style: none;
  }
  .tier__list li {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .chk {
    color: var(--accent-ink);
  }
  .tier__cta {
    margin-top: auto;
  }
  .tiers__foot {
    max-width: 70ch;
    margin: 1.5rem auto 0;
    text-align: center;
  }
  @media (max-width: 860px) {
    .tiers {
      grid-template-columns: minmax(0, 1fr);
      max-width: 36rem;
      margin-inline: auto;
    }
    .tier__price {
      min-height: auto;
    }
  }
</style>
