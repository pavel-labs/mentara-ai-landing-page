---
// Keep these product facts free of unverified usage numbers and ratings.
import { getDict, type Locale } from '../../i18n/index';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const items = getDict(locale).proof;
---

<div class="proof">
  <ul class="container proof__row">
    {items.map((item) => (
      <li class="proof__item">
        <span class="proof__tick" aria-hidden="true">
          ›
        </span>
        {item}
      </li>
    ))}
  </ul>
</div>

<style>
  .proof {
    padding-top: 2.25rem;
  }
  .proof__row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem 2rem;
    list-style: none;
  }
  .proof__item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.9375rem;
    font-weight: 550;
  }
  .proof__tick {
    color: var(--accent-ink);
  }
  @media (max-width: 600px) {
    .proof__row {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 1rem;
    }
    .proof__item {
      font-size: 0.75rem;
      gap: 0.5rem;
    }
  }
</style>
