---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/hanken-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';
import { SITE } from '../consts';
import LocaleAuto from '../components/LocaleAuto.astro';
import {
  DEFAULT_LOCALE,
  LOCALES,
  getDict,
  localePath,
  localeUrl,
  pathWithoutLocale,
  withBase,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Home pages only: send first-time visitors to their browser language. */
  autoLocale?: boolean;
  /** Emit FAQPage structured data – only on pages that actually render the FAQ. */
  includeFaq?: boolean;
  /** Extra JSON-LD nodes for this page (BreadcrumbList, BlogPosting, …). */
  jsonLd?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  ogImageUrl?: string;
  suppressAlternates?: boolean;
  faqItems?: { q: string; a: string }[];
  analytics?: boolean;
  /**
   * Content that exists in one language only (the English blog) and is merely served
   * under every locale prefix. The canonical then points at the English URL and no
   * hreflang alternates are emitted – otherwise each locale copy is a duplicate page.
   */
  singleLanguage?: boolean;
}

const {
  locale,
  title,
  description,
  autoLocale = false,
  includeFaq = false,
  jsonLd: pageJsonLd = [],
  ogType = 'website',
  singleLanguage = false,
  ogImageUrl, suppressAlternates = false, faqItems, analytics = true,
} = Astro.props;
const t = getDict(locale);
const pageTitle = title ?? t.meta.title;
const pageDesc = description ?? t.meta.description;

// All asset paths go through the single `withBase` joiner – no ad-hoc base math here.
const origin = Astro.site ?? new URL(SITE.domain);
const pagePath = pathWithoutLocale(Astro.url.pathname);
const canonical = new URL(
  singleLanguage ? localePath(DEFAULT_LOCALE, pagePath) : Astro.url.pathname,
  origin,
).href;
const favicon = withBase('favicon.svg');
const ogImage = ogImageUrl ?? new URL(withBase(`og/${locale}.png`), origin).href;
const sitemapHref = withBase('sitemap-index.xml');
const rssHref = withBase('rss.xml');
const manifestHref = withBase('site.webmanifest');
const appleIcon = withBase('apple-touch-icon.png');

// hreflang alternates: the same page in every locale, x-default → its English version.
// Every localized route exists in all locales (the parity test and the per-locale page
// wrappers guarantee it), so the swap of the locale prefix is always a real page.
const alternateHref = (l: Locale) => new URL(localePath(l, pagePath), origin).href;
const alternates = singleLanguage || suppressAlternates
  ? []
  : LOCALES.map((l) => ({ hreflang: l, href: alternateHref(l) }));

// Cloudflare Web Analytics – privacy-friendly, cookieless. Only injected when a token is
// provided, so dev/forks ship no beacon and no consent banner is needed.
const cfToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN;

// One JSON-LD @graph: the org, the app, the FAQ where it is shown, and any page nodes.
// FAQPage is emitted only next to a rendered FAQ – markup for content that is not on the
// page is what Google treats as spam.
const faqNode = {
  '@type': 'FAQPage',
  inLanguage: locale,
  mainEntity: (faqItems ?? t.faq.items).map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin.origin}/#org`,
      name: SITE.name,
      url: SITE.domain,
      logo: new URL(favicon, origin).href,
    },
    {
      '@type': 'SoftwareApplication',
      name: SITE.name,
      applicationCategory: 'EducationApplication',
      operatingSystem: 'Web, iOS, Android',
      description: t.meta.description,
      url: localeUrl(locale, origin),
      publisher: { '@id': `${origin.origin}/#org` },
      // Only the Free plan has a public price; Pro is set at launch, Enterprise by contract.
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD', name: 'Free' },
      featureList: [
        t.interview.eyebrow,
        t.assessment.eyebrow,
        t.report.eyebrow,
        t.progress.eyebrow,
        t.teamsBand.eyebrow,
      ],
    },
    ...(includeFaq ? [faqNode] : []),
    ...pageJsonLd,
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* Before paint, so a redirected visitor never sees the wrong language flash. */}
    {autoLocale && <LocaleAuto locale={locale} />}

    <slot name="head" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {
      !singleLanguage && !suppressAlternates && (
        <link rel="alternate" hreflang="x-default" href={alternateHref(DEFAULT_LOCALE)} />
      )
    }
    <meta name="theme-color" content="#0b0b0d" />
    <meta name="color-scheme" content="dark" />

    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="mask-icon" href={favicon} color="#d2603a" />
    <link rel="apple-touch-icon" href={appleIcon} />
    <link rel="manifest" href={manifestHref} />
    <link rel="sitemap" href={sitemapHref} />
    <link rel="alternate" type="application/rss+xml" title="Mentara Blog" href={rssHref} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDesc} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

    {
      analytics && cfToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token":"${cfToken}","spa":true}`}
        />
      )
    }
  </head>
  <body>
    <a href="#main" class="skip">{t.a11ySkip}</a>
    <slot />
    {analytics && <script src="../marketing/analytics.ts"></script>}
    <style>
      .skip {
        position: absolute;
        left: -999px;
        top: 0.75rem;
        z-index: 100;
        background: var(--amber);
        color: var(--ink);
        padding: 0.6rem 1rem;
        border-radius: 0 0 10px 0;
        font-family: var(--font-mono);
        font-size: 0.8rem;
      }
      .skip:focus {
        left: 0;
      }
    </style>
  </body>
</html>
