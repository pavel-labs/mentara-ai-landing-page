---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Nav from '../../../components/shared/Nav.astro';
import Footer from '../../../components/shared/Footer.astro';
import Articles from '../../../features/blog/Articles.astro';
import { LOCALES, localeHome } from '../../../i18n';
import { marketingLabels } from '../../../marketing/content';
export function getStaticPaths() { return LOCALES.filter((locale) => locale !== 'en').map((locale) => ({ params: { locale }, props: { locale } })); }
const { locale } = Astro.props;
---
<BaseLayout locale={locale} title={`${marketingLabels(locale).articles} · Mentarika`}>
  <Nav locale={locale} homeHref={localeHome(locale)} />
  <main id="main"><Articles locale={locale} /></main>
  <Footer locale={locale} />
</BaseLayout>
