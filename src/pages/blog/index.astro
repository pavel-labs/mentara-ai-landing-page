---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { BLOG_CLUSTERS } from '../../content/blog-clusters';
import { localeHome, withBase } from '../../i18n';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const postById = new Map(posts.map((post) => [post.id, post] as const));
const readingPaths = BLOG_CLUSTERS.map((cluster) => ({
  ...cluster,
  posts: cluster.slugs.map((slug) => postById.get(slug)).filter((p): p is NonNullable<typeof p> => p != null),
}));
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  locale="en"
  title="Blog — Mentara"
  description="Interview prep articles, product notes, and launch updates from Mentara."
>
  <Nav locale="en" homeHref={localeHome('en')} />
  <main id="main" class="blog">
    <div class="container blog__inner">
      <p class="eyebrow">Articles</p>
      <h1 class="h2">Interview prep, product notes, and build updates.</h1>
      <p class="blog__intro">
        Comparisons, practice strategy, and a closer look at what we are building for
        engineers who want sharper mock interviews.
      </p>
      <div class="blog__links">
        <a href={withBase('resources')} class="blog__hub">
          Browse resources →
        </a>
        <a href={withBase('compare')} class="blog__hub">
          See comparison pages →
        </a>
      </div>

      <section class="paths" aria-labelledby="paths-title">
        <div class="paths__head">
          <p class="eyebrow">Reading paths</p>
          <h2 id="paths-title" class="h3">Search clusters, not a random pile of posts.</h2>
        </div>

        <div class="paths__grid">
          {
            readingPaths.map((path) => (
              <section class="path">
                <h3 class="path__title">{path.title}</h3>
                <p class="path__lede">{path.lede}</p>
                <ul class="path__list">
                  {path.posts.map((post) => (
                    <li>
                      <a href={withBase(`blog/${post.id}`)}>{post.data.title}</a>
                    </li>
                  ))}
                </ul>
              </section>
            ))
          }
        </div>
      </section>

      <ul class="posts">
        {
          posts.map((p) => (
            <li class="post">
              <a href={withBase(`blog/${p.id}`)} class="post__link">
                <time class="post__date mono" datetime={p.data.date.toISOString()}>
                  {fmt(p.data.date)}
                </time>
                <h2 class="post__title">{p.data.title}</h2>
                <p class="post__sum">{p.data.summary}</p>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
  <Footer locale="en" />
</BaseLayout>

<style>
  .blog {
    padding-block: clamp(3rem, 7vw, 6rem);
  }
  .blog__inner {
    max-width: 52rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .posts {
    list-style: none;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
  }
  .blog__links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .blog__hub {
    font-family: var(--font-mono);
    color: var(--amber);
  }
  .paths {
    margin-top: 2rem;
    padding: 1.5rem;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink-2) 62%, transparent);
  }
  .paths__head {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .paths__grid {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .path {
    padding: 1rem;
    border: 1px solid var(--line);
    background: color-mix(in oklab, var(--ink) 38%, transparent);
  }
  .path__title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }
  .path__lede {
    margin-top: 0.45rem;
    color: var(--bone-dim);
    line-height: 1.6;
  }
  .path__list {
    margin-top: 0.8rem;
    padding-left: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    color: var(--bone-dim);
  }
  .path__list a:hover {
    color: var(--amber);
  }
  .blog__intro {
    color: var(--bone-dim);
    line-height: 1.7;
    max-width: 44rem;
  }
  .post {
    border-top: 1px solid var(--line);
  }
  .post:last-child {
    border-bottom: 1px solid var(--line);
  }
  .post__link {
    display: block;
    padding: 1.6rem 0;
    transition: opacity 0.2s;
  }
  .post__link:hover {
    opacity: 0.85;
  }
  .post__date {
    color: var(--amber);
  }
  .post__title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin: 0.4rem 0;
  }
  .post__sum {
    color: var(--bone-dim);
    line-height: 1.6;
  }
  @media (max-width: 820px) {
    .paths__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
